# CodeInOven — environment variables
#
# Copy this file to `.env` and fill in values for local development.
# Never commit a real `.env` file. Production secrets live in Coolify project
# environment variables and GitHub Actions secrets — never in this file, the
# repository, or the Docker image.

# --- Development only ---
# Port/preload for the Electron renderer in development (set by electron-vite).
# ELECTRON_RENDERER_URL=http://localhost:5173

# --- Optional driver overrides ---
# Path to a CUA driver binary if the auto-detected one is not on PATH.
# CUA_DRIVER_PATH=

# --- Utility bridge (internal) ---
# Base URL and bearer token for the utility bridge service. Only needed when
# running the optional bridge service.
# CODEINOVEN_UTILITY_BRIDGE_URL=
# CODEINOVEN_UTILITY_BRIDGE_TOKEN=

# --- Signing / notarization (CI only) ---
# Used by electron-builder in the release workflow. Never set these in a
# committed file; they are injected by GitHub Actions secrets.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# --- Remote connection ---
# Local development works with zero configuration: every variable below falls
# back to a localhost-only development value when unset. Production values are
# deployment-time requirements and must never be invented or committed.
#
# Relay-backed routing works on every supported browser. Direct LAN is an
# optional performance path when the desktop's local certificate has already
# been trusted on the phone; otherwise browser certificate/private-network
# policy makes the client use the public relay automatically.
#
# LAN (local network)
# LAN_ENABLED=true
# LAN_PORT=4455
# LAN_LOCAL_PORT=4456
# LAN_USE_MDNS=false
# LAN_HOSTS=localhost
#
# Hosted account + relay service. Main-process only: never add a VITE_ prefix
# to runtime credentials because desktop device credentials are issued at
# runtime and stored in the OS credential vault. Local HTTP is a development-
# only fallback; production uses the documented HTTPS origin below.
# REMOTE_API_ORIGIN=http://localhost:8877
# REMOTE_API_ORIGIN=https://mobile.codeinoven.com
# MAIN_VITE_REMOTE_API_ORIGIN=https://mobile.codeinoven.com
#
# Production release gate: set both a non-empty RELAY_TOKEN and an explicit
# absolute RELAY_URL using wss:. Localhost and ws: are development/test-only;
# there is intentionally no production relay hostname or fallback here.
# RELAY_URL=
# RELAY_TOKEN=
#
# Shared peer authentication secret (phone <-> desktop handshake)
# OPTIONAL for LAN: when unset, the desktop generates one and delivers it to the
# phone through the QR pairing URL. Set it to pin a secret of your own.
# PEER_SECRET_AUTH=
#
# Public base URL of the stable installable phone client. Production should
# reverse-proxy /v1 and /v1/relay beneath this exact same HTTPS origin.
# PUBLIC_REMOTE_PWA_URL=https://mobile.codeinoven.com
#
# Hosted account OAuth (Coolify/server only). OAuth callbacks are:
# https://mobile.codeinoven.com/api/auth/callback/google
# https://mobile.codeinoven.com/api/auth/callback/apple
# BETTER_AUTH_URL=https://mobile.codeinoven.com
# BETTER_AUTH_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# APPLE_OAUTH_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Store the .p8 key as one line with newlines escaped as \n.
# APPLE_PRIVATE_KEY=

# --- Git provider API base URL (optional) ---
# Git provider REST API host used for pull requests. When unset the app uses the
# public GitHub.com API (https://api.github.com). Self-hosted providers are
# deferred: this variable MUST be set to an explicit, verified HTTPS host to opt
# in (a localhost value is allowed as a development/test mock only) — the app
# never invents or guesses a host.
# CODEINOVEN_GIT_PROVIDER_API_BASE_URL=https://github.example.com/api/v3

# --- GitHub sign-in (device flow) ---
# Public client ID of the CodeInOven GitHub App, baked in at build time by
# electron-vite. Copy it from the GitHub App's page
# (github.com/settings/apps → your app → Client ID). The runtime override
# also works for CI shells and tests.
# CODEINOVEN_GITHUB_CLIENT_ID=Iv1.exampleClientId
