# CodeInOven — environment variables
#
# Copy this file to `.env` and fill in values for local development.
# Never commit a real `.env` file. Production secrets live in Coolify project
# environment variables and GitHub Actions secrets — never in this file, the
# repository, or the Docker image.

# --- Development only ---
# Port/preload for the Electron renderer in development (set by electron-vite).
# ELECTRON_RENDERER_URL=http://localhost:5173

# --- Optional driver overrides ---
# Path to a CUA driver binary if the auto-detected one is not on PATH.
# CUA_DRIVER_PATH=

# --- Utility bridge (internal) ---
# Base URL and bearer token for the utility bridge service. Only needed when
# running the optional bridge service.
# CODEINOVEN_UTILITY_BRIDGE_URL=
# CODEINOVEN_UTILITY_BRIDGE_TOKEN=

# --- Signing / notarization (CI only) ---
# Used by electron-builder in the release workflow. Never set these in a
# committed file; they are injected by GitHub Actions secrets.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
