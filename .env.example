# CodeInOven — environment variables
#
# Copy this file to `.env` and fill in values for local development.
# Never commit a real `.env` file. Production secrets live in Coolify project
# environment variables and GitHub Actions secrets — never in this file, the
# repository, or the Docker image.

# --- Development only ---
# Port/preload for the Electron renderer in development (set by electron-vite).
# ELECTRON_RENDERER_URL=http://localhost:5173
#
# Renderer dev-server port. The project root keeps the stable 5173; a linked Git
# worktree derives its own stable port automatically, so this is only needed to
# pin a specific port. Resolution: electron.vite.config.ts.
# CODEINOVEN_RENDERER_PORT=5200
#
# App data root for one instance. Any absolute path; honored by unpackaged
# launches (bun dev, electron-vite preview) and by the packaged startup smoke
# harness. A shipped app ignores it, so a stray variable can never repoint a
# user's real data root. Leave unset to share the default root. Set it on the
# dev command line; the app never reads .env at runtime.
# CODEINOVEN_CONFIG_ROOT=/Users/you/.config/pillardash/codeinoven-dev
#
# Extra Electron switches for the dev app (JSON array, appended by electron-vite).
# Use it to give an instance its own Chromium profile:
# ELECTRON_CLI_ARGS=["--user-data-dir=/Users/you/.config/pillardash/codeinoven-dev/chromium"]

# --- Optional driver overrides ---
# Path to a CUA driver binary if the auto-detected one is not on PATH.
# CUA_DRIVER_PATH=

# --- Utility bridge (internal) ---
# Base URL and bearer token for the utility bridge service. Only needed when
# running the optional bridge service.
# CODEINOVEN_UTILITY_BRIDGE_URL=
# CODEINOVEN_UTILITY_BRIDGE_TOKEN=

# --- Signing / notarization (CI only) ---
# Used by electron-builder in the release workflow. Never set these in a
# committed file; they are injected by GitHub Actions secrets.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# --- Download mirror upload (release tooling only) ---
# Cloudflare R2 credentials used by scripts/publish-release-mirror.ts to copy a
# published release to dl.codeinoven.com. In CI they come from GitHub Actions
# variables/secrets; locally, put them here to run `bun run release:mirror`.
# Never commit real values. Setup: docs/DOWNLOAD-MIRROR.md.
# DOWNLOAD_MIRROR_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# DOWNLOAD_MIRROR_S3_BUCKET=codeinoven-downloads
# DOWNLOAD_MIRROR_S3_REGION=auto
# DOWNLOAD_MIRROR_S3_ACCESS_KEY_ID=
# DOWNLOAD_MIRROR_S3_SECRET_ACCESS_KEY=

# Public origin for generated Engineering prototype previews.
# Runtime override used by packaged desktops:
# CODEINOVEN_PUBLIC_PROTOTYPE_PREVIEW_ORIGIN=https://<your-preview-origin>
# Build-time public value baked into the main bundle:
# MAIN_VITE_PUBLIC_PROTOTYPE_PREVIEW_ORIGIN=https://<your-preview-origin>
# Production requires an explicit HTTPS value. Development may omit both and
# use the app-owned http://127.0.0.1:<allocated-port> preview service.

# --- Git provider API base URL (optional) ---
# Git provider REST API host used for pull requests. When unset the app uses the
# public GitHub.com API (https://api.github.com). Self-hosted providers are
# deferred: this variable MUST be set to an explicit, verified HTTPS host to opt
# in (a localhost value is allowed as a development/test mock only) — the app
# never invents or guesses a host.
# CODEINOVEN_GIT_PROVIDER_API_BASE_URL=https://github.example.com/api/v3

# --- Self-hosted Coolify base URL (required for Coolify deployments) ---
# Base URL of the user's own, self-hosted Coolify instance that the app reaches
# to monitor cloud deployments. It follows the same contract as the Git provider
# above: it MUST be an explicit, verified URL supplied by the user — never
# invented, guessed, or derived from NODE_ENV. A localhost value (http or https)
# is permitted only as a development/test mock; production use requires a real
# value (an HTTPS host the user controls) before deployment monitoring is ready.
# There is no default and no production host is hardcoded anywhere.
# CODEINOVEN_COOLIFY_BASE_URL=https://coolify.your-domain.example

# --- GitHub sign-in (device flow) ---
# Public client ID of the CodeInOven GitHub App, baked in at build time by
# electron-vite. Copy it from the GitHub App's page
# (github.com/settings/apps → your app → Client ID). The runtime override
# also works for CI shells and tests.
# CODEINOVEN_GITHUB_CLIENT_ID=Iv1.exampleClientId
