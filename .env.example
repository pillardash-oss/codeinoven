# CodeInOven — environment variables
#
# Copy this file to `.env` and fill in values for local development.
# Never commit a real `.env` file. Production secrets live in Coolify project
# environment variables and GitHub Actions secrets — never in this file, the
# repository, or the Docker image.

# --- Development only ---
# Port/preload for the Electron renderer in development (set by electron-vite).
# ELECTRON_RENDERER_URL=http://localhost:5173

# --- Optional driver overrides ---
# Path to a CUA driver binary if the auto-detected one is not on PATH.
# CUA_DRIVER_PATH=

# --- Utility bridge (internal) ---
# Base URL and bearer token for the utility bridge service. Only needed when
# running the optional bridge service.
# CODEINOVEN_UTILITY_BRIDGE_URL=
# CODEINOVEN_UTILITY_BRIDGE_TOKEN=

# --- Signing / notarization (CI only) ---
# Used by electron-builder in the release workflow. Never set these in a
# committed file; they are injected by GitHub Actions secrets.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# --- Remote connection ---
# Local development works with zero configuration: every variable below falls
# back to a localhost-only development value when unset. Production values are
# deployment-time requirements and must never be invented or committed — see
# agent-out/config.md. Renderer bundles also honour a VITE_ prefix (e.g.
# VITE_RELAY_URL) because Electron renderers can only see VITE_-prefixed vars.
#
# LAN-first routing: the phone client connects over the local network when a
# peer is reachable and only falls back to the cloud relay otherwise. On the
# LAN nothing needs to be configured — open Settings → Remote, scan the QR code
# with your phone, and the phone connects automatically.
#
# LAN (local network)
# LAN_ENABLED=true
# LAN_PORT=4455
# LAN_LOCAL_PORT=4456
# LAN_USE_MDNS=false
# LAN_HOSTS=localhost
#
# Cloud relay fallback (remote networks)
# The relay is a deployment-time option. When RELAY_URL/RELAY_TOKEN are unset it
# stays disabled and the client is LAN-only — it never errors and never invents
# a domain.
# RELAY_ENABLED=true
# RELAY_URL=ws://localhost:8877
# RELAY_TOKEN=
#
# MQTT signaling (optional, used when a broker is configured)
# MQTT_URL=ws://localhost:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
#
# Shared peer authentication secret (phone <-> desktop handshake)
# OPTIONAL for LAN: when unset, the desktop generates one and delivers it to the
# phone through the QR pairing URL. Set it to pin a secret of your own.
# PEER_SECRET_AUTH=
#
# Public base URL of the phone client
# PUBLIC_REMOTE_PWA_URL=http://localhost:5173

# --- Git provider API base URL (optional) ---
# Git provider REST API host used for pull requests. When unset the app uses the
# public GitHub.com API (https://api.github.com). Self-hosted providers are
# deferred: this variable MUST be set to an explicit, verified HTTPS host to opt
# in (a localhost value is allowed as a development/test mock only) — the app
# never invents or guesses a host.
# CODEINOVEN_GIT_PROVIDER_API_BASE_URL=https://github.example.com/api/v3

# --- GitHub sign-in (device flow) ---
# Public client ID of the CodeInOven GitHub App, baked in at build time by
# electron-vite. Requires the MAIN_VITE_ prefix so the main process can see it
# via import.meta.env. Copy it from the GitHub App's page
# (github.com/settings/apps → your app → Client ID). The runtime override
# CODEINOVEN_GITHUB_CLIENT_ID also works for CI shells and tests.
# MAIN_VITE_GITHUB_CLIENT_ID=Iv1.exampleClientId
