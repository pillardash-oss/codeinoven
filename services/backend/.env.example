# CodeInOven backend configuration.
# Every value below is read from the process environment; there is no .env file loader.
# `bun run dev` in this directory passes these through unchanged.

# --- Core -------------------------------------------------------------------
# Listen address. The mobile dev server proxies to http://127.0.0.1:8080.
HTTP_ADDR=127.0.0.1:8080

# Postgres connection string. `bash scripts/db-setup.sh` creates codeinoven_dev.
DATABASE_URL=postgres://localhost:5432/codeinoven_dev?sslmode=disable

# This service's own origin: callback URLs, verification links and OAuth
# redirects are built from it. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Comma separated browser origins allowed by CORS. The Capacitor origins
# (capacitor://localhost, http://localhost) and http://127.0.0.1:5174 are always allowed.
APP_ORIGINS=http://127.0.0.1:5174

# Session lifetime, Go duration syntax. Default 720h (30 days).
SESSION_TTL=720h

# HMAC key for signed OAuth state cookies. Required in production.
SESSION_SECRET=development-only-session-secret

# development | production. Controls log level, cookie Secure, and the mail sender:
# in production startup fails while no real mail sender exists.
ENVIRONMENT=development

# --- OAuth ------------------------------------------------------------------
# Leave a whole pair empty to disable that provider: /v1/auth/{provider}/start answers 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Seeding (cmd/seed only) ------------------------------------------------
SEED_PASSWORD=oven-mobile-demo-pass
