{
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss: ws:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}

	@account path /api/auth /api/auth/* /desktop/* /v1/desktop-auth/* /v1/profile
	handle @account {
		reverse_proxy {$CONVEX_SITE_URL} {
			header_up Host {upstream_hostport}
			header_up X-Client-IP {client_ip}
		}
	}

	@relay path /v1/* /healthz
	handle @relay {
		reverse_proxy remote-control:8877 {
			header_up X-Client-IP {client_ip}
		}
	}

	@pwaRoot path /
	rewrite @pwaRoot /remote.html

	# Hashed JavaScript/CSS assets must never use the SPA fallback. Returning
	# remote.html with a 200 for a stale chunk URL makes dynamic import() fail
	# with an opaque module parse error and lets the service worker cache HTML
	# under the asset URL.
	@pwaAssets path /assets/*
	handle @pwaAssets {
		root * /srv/codeinoven/renderer
		file_server
	}

	handle {
		root * /srv/codeinoven/renderer
		try_files {path} /remote.html
		file_server
	}
}
