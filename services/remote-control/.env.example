HOST=127.0.0.1
PORT=8877
NODE_ENV=production
REMOTE_DATABASE_PATH=/var/lib/codeinoven/remote-control.sqlite
BETTER_AUTH_URL=https://mobile.codeinoven.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Apple Service ID, Team ID, Sign in with Apple key ID, and .p8 private key.
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the .p8 key as one line with newlines escaped as \n.
APPLE_PRIVATE_KEY=
# Exact public PWA origins, comma-separated. The API/relay should normally be
# reverse-proxied beneath the same origin so Strict cookies work everywhere.
REMOTE_ALLOWED_ORIGINS=https://mobile.codeinoven.com
REMOTE_TRUST_PROXY=true
