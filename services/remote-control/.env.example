# Required production secrets. These belong only on the remote-control service.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud OAuth web client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Service ID, Team ID, Sign in with Apple key ID, and .p8 private key.
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the .p8 key as one line with newlines escaped as \n.
APPLE_PRIVATE_KEY=
