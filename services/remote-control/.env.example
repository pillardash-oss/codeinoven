# Required public Convex HTTP-actions origin. Set the same value on both Coolify services.
CONVEX_SITE_URL=https://example-deployment.convex.site

# Enable only when the service is reachable exclusively through the provided trusted proxy.
TRUST_PROXY=1

# WebRTC ICE. STUN enables direct NAT traversal. TURN is the guaranteed fallback.
REMOTE_STUN_URLS=stun:stun.cloudflare.com:3478
REMOTE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Coturn `use-auth-secret` value. Credentials issued to approved peers expire automatically.
REMOTE_TURN_SHARED_SECRET=replace-with-a-long-random-secret
REMOTE_TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional local/test override. Production Compose uses /data/remote-control.sqlite by default.
# REMOTE_DATABASE_PATH=/data/remote-control.sqlite
