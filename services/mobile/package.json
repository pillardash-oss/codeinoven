{
  "name": "codeinoven-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 6174 --strictPort",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "native:add:ios": "cap add ios",
    "native:add:android": "cap add android",
    "native:sync": "bun run build && cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@pdslng/cio-icon": "^0.1.1",
    "bits-ui": "^2.20.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
