# Generate once with: openssl rand -base64 48
# Set this exact value as REMOTE_TURN_SHARED_SECRET on the remote-control service.
TURN_SHARED_SECRET=replace-with-a-long-random-secret

TURN_REALM=turn.codeinoven.com
# Prefer the server's stable public IP. Use auto only when its outbound public IP is stable.
TURN_EXTERNAL_IP=203.0.113.10

TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Abuse and capacity controls. Values are bytes/second where noted.
TURN_UNAUTHORIZED_RATELIMIT_RPS=10
TURN_USER_QUOTA=4
TURN_TOTAL_QUOTA=40
TURN_MAX_BPS=2000000
TURN_BPS_CAPACITY=50000000
TURN_MAX_ALLOCATE_TIMEOUT=10

# Container resource ceilings interpreted by Docker Compose.
TURN_CPU_LIMIT=2.0
TURN_MEMORY_LIMIT=512m

# Only set when Docker bridge/NAT requires an explicit public/private mapping.
# TURN_RELAY_IP=172.17.0.2
