node_modules/
out/
dist/
/resources/speech/runtime/
/resources/harnesses/pi/
*.log
.DS_Store
Thumbs.db

# The publishable cio-oven package is generated by scripts/build-oven-cli.ts:
# its CLI bundle and embedded Oven service are build outputs, and its LICENSE is
# copied from the repository root.
/packages/cio-oven/dist/
/packages/cio-oven/LICENSE

# Env
.env
.env.*
!.env.example

# Agents
/.qoder
/.cio
/.opencode

# Generated TypeScript transpile artifacts   the .ts files are the source of
# truth; these .js copies are emitted next to their sources by a tsc transpile
# run and must never be tracked or shadow the real sources.
/src/main/**/*.js
/src/lib/**/*.js
/src/preload/**/*.js
# ...except the browser extension compatibility scripts, which are hand-written runtime
# scripts with no TypeScript source beside them. The extension install path imports
# them with `?raw`, so ignoring them would leave a fresh checkout able to resolve
# everything except the files that make four of the five supported extensions start
# at all.
!/src/main/browser/extensions/compat/*.js
/.svelte-check/
.claude/

# Mac code-signing assets supplied per build rather than committed: the WebAuthn
# entitlements file is generated from a checked-in base plus a team identifier,
# and a provisioning profile is a per-team portal artifact that must never be
# committed even though it holds no private key.
/build/entitlements.mac.webauthn.plist
*.provisionprofile
*.mobileprovision
