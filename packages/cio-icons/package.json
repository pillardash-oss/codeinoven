{
  "name": "@codeinoven/icons",
  "version": "0.1.0",
  "description": "The handcrafted CIO icon set as reusable Svelte components.",
  "license": "MIT",
  "author": {
    "name": "Pillardash Solutions Limited",
    "email": "hey@pillardash.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pillardash-oss/codeinoven.git",
    "directory": "packages/cio-icons"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    "./glyph": {
      "types": "./dist/glyph.d.ts",
      "svelte": "./dist/glyph.js",
      "default": "./dist/glyph.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1"
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
