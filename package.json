{
  "name": "codeinoven",
  "version": "0.5.62",
  "description": "CodeInOven   Desktop workstation for coordinated agentic software engineering",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13.0"
  },
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "packages/cio-icons"
  ],
  "author": {
    "name": "Pillardash Solutions Limited",
    "email": "hey@pillardash.com"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static"
  ],
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "mediabunny": "1.61.3",
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "@xmldom/xmldom": "0.9.12",
    "plist": "3.1.1",
    "qs": "6.16.0",
    "fast-uri": "3.1.8",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "undici": "6.28.1",
    "hono": "^4.13.7",
    "js-yaml": "^4.3.2",
    "lodash-es": "^4.18.1",
    "katex": "0.19.0",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "postinstall": "bun scripts/ensure-electron-binary.ts && bun scripts/ensure-ffmpeg-binary.ts && bun scripts/patch-binary-data.ts && bun scripts/patch-mammoth-xmldom.ts && bun scripts/patch-electron-builder-keychain.ts && electron-builder install-app-deps && bun scripts/ensure-pty-helper.ts",
    "predev": "bun scripts/ensure-ffmpeg-binary.ts && bun scripts/ensure-pty-helper.ts && bun scripts/ensure-electron-binary.ts && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun scripts/brand-electron.ts",
    "dev": "electron-vite dev",
    "dev:probe": "bun scripts/dev-probe.ts",
    "probe": "bun scripts/probe.ts",
    "build": "electron-vite build",
    "build:production": "bun scripts/ensure-ffmpeg-binary.ts && electron-vite build --mode production",
    "preview": "electron-vite preview",
    "check": "bun scripts/check.ts",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write",
    "test": "vitest run",
    "check:bundle": "bun scripts/check-bundle-budgets.ts",
    "verify:packaged-app": "bun run scripts/verify-packaged-app.ts",
    "smoke:packaged": "bun run scripts/smoke-packaged-app.ts",
    "icons:build": "bun scripts/icons/build-icons.ts",
    "speech:catalog": "bun scripts/benchmark-speech-models.ts",
    "speech:build-mlx": "bun scripts/build-mlx-speech-worker.ts",
    "speech:build-coreml": "bun scripts/build-coreml-speech-worker.ts",
    "speech:build-native-capture": "bun scripts/build-native-speech-capture.ts",
    "harness:build-pi": "bun scripts/build-pi-harness.ts",
    "oven:cli:build": "bun scripts/build-oven-cli.ts",
    "oven:version:bump": "bun scripts/bump-oven-cli-version.ts",
    "ci:local": "bun scripts/ci-local.ts",
    "audit": "bun audit --ignore=GHSA-ch52-4w7c-c8xp --ignore=GHSA-hp3w-g68c-fv3c --ignore=GHSA-2p57-rm9w-gvfp",
    "verify": "bun run check && bun run lint . && bun run test && bun run audit",
    "verify:release": "bun run verify && bun run build:production && bun run check:bundle",
    "version:bump": "bun scripts/bump-version.ts",
    "package": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run build:production && electron-builder --dir -c.forceCodeSigning=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "package:mac": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run build:production && electron-builder --mac -c.forceCodeSigning=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "package:linux": "bun run harness:build-pi && bun run build:production && electron-builder --linux -c.forceCodeSigning=false",
    "package:win": "bun run harness:build-pi && bun run build:production && electron-builder --win --x64 -c.forceCodeSigning=false -c.npmRebuild=false",
    "release:mac": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run verify:release && electron-builder --mac",
    "deploy:nightly": "bash scripts/deploy-nightly.sh",
    "deploy:main": "bash scripts/deploy-main.sh",
    "release:mirror": "bun scripts/publish-release-mirror.ts",
    "winget:manifest": "bun scripts/winget-manifest.ts",
    "msix:check": "bun scripts/msix.ts --check",
    "msix:build": "bun scripts/msix.ts"
  },
  "dependencies": {
    "@codeinoven/icons": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@firecrawl/anydoc": "^0.2.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.3.0",
    "gemoji": "^8.1.0",
    "jszip": "3.10.2",
    "mammoth": "1.12.3",
    "node-pty": "1.1.0",
    "sherpa-onnx-node": "1.13.8",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "@firecrawl/anydoc-win32-x64-msvc": "0.2.4"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@baybreezy/file-extension-icon": "^0.0.5",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.0",
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.2.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mediabunny/server": "1.61.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/video-matting": "4.0.535",
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "0.35.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.3",
    "builder-util": "26.15.3",
    "dompurify": "^3.4.16",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "ghostty-web": "^0.4.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.1",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.14",
    "mediabunny": "1.61.3",
    "mermaid": "^12.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-git": "^4.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "patchedDependencies": {
    "svelte-sonner@1.2.1": "patches/svelte-sonner@1.2.1.patch"
  }
}
