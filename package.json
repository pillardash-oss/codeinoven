{
  "name": "codeinoven",
  "version": "0.5.53",
  "description": "CodeInOven — Desktop workstation for coordinated agentic software engineering",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13.0"
  },
  "main": "out/main/index.js",
  "type": "module",
  "author": {
    "name": "Pillardash Solutions Limited",
    "email": "hey@pillardash.com"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "uuid": "11.1.1"
  },
  "scripts": {
    "postinstall": "bun scripts/patch-binary-data.ts && electron-builder install-app-deps",
    "predev": "bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun scripts/brand-electron.ts",
    "dev": "electron-vite dev",
    "dev:remote-pwa": "bun scripts/dev-remote-pwa.ts",
    "dev:remote-pwa:tunnel": "bun scripts/dev-remote-pwa.ts --tunnel",
    "build": "electron-vite build",
    "build:production": "electron-vite build --mode production",
    "preview": "electron-vite preview",
    "check": "bun scripts/check.ts",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write",
    "test": "vitest run",
    "check:bundle": "bun scripts/check-bundle-budgets.ts",
    "verify:packaged-app": "bun run scripts/verify-packaged-app.ts",
    "smoke:packaged": "bun run scripts/smoke-packaged-app.ts",
    "speech:catalog": "bun scripts/benchmark-speech-models.ts",
    "speech:build-mlx": "bun scripts/build-mlx-speech-worker.ts",
    "speech:build-coreml": "bun scripts/build-coreml-speech-worker.ts",
    "speech:build-native-capture": "bun scripts/build-native-speech-capture.ts",
    "harness:build-pi": "bun scripts/build-pi-harness.ts",
    "verify": "bun run check && bun run lint . && bun run test && bun audit",
    "verify:release": "bun run verify && bun run build:production && bun run check:bundle",
    "version:bump": "bun scripts/bump-version.ts",
    "package": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run build:production && electron-builder --dir -c.forceCodeSigning=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "package:mac": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run build:production && electron-builder --mac -c.forceCodeSigning=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "package:linux": "bun run harness:build-pi && bun run build:production && electron-builder --linux -c.forceCodeSigning=false",
    "package:win": "bun run harness:build-pi && bun run build:production && electron-builder --win -c.forceCodeSigning=false",
    "release:mac": "bun run harness:build-pi && bun run speech:build-mlx && bun run speech:build-coreml && bun run speech:build-native-capture && bun run verify:release && electron-builder --mac",
    "deploy:nightly": "bash scripts/deploy-nightly.sh",
    "deploy:main": "bash scripts/deploy-main.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@xmldom/xmldom": "0.8.13",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.2.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "node-pty": "1.1.0",
    "sherpa-onnx-node": "1.13.6",
    "web-push": "^3.6.7",
    "werift": "^0.24.4",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@baybreezy/file-extension-icon": "^0.0.5",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^10.0.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@lucide/svelte": "^1.31.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@7",
    "better-auth": "^1.6.26",
    "bits-ui": "^2.19.0",
    "builder-util": "26.15.3",
    "dompurify": "^3.4.13",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "ghostty-web": "^0.4.0",
    "globals": "^17.9.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "qr-scanner": "1.4.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "simple-git": "^3.36.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
